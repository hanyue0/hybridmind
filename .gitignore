# 环境与密钥
.env
*.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 数据与产物（评测结果按需保留，避免仓库膨胀）
data/results/*.json
data/results/*.jsonl

# 论文语料：PDF 与解析缓存不进 git
# 三篇语料是 arXiv non-exclusive license，重建方式见 data/papers/README.md
data/papers/*.pdf
data/papers/*.chunks.json
data/papers/*.zh.json
data/papers/.cache/
data/papers/uploads/

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 视频与临时文件
*.mp4
*.mov
*.wav
*.m4a
raw_footage/
scratch/
docs/video/

# 模型权重（体积大，按需下载）
models/

# 人声素材（本地保留，不进仓库）
data/voiceover_norm/
data/voiceover_v2/
