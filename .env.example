# ===== 本地推理（Ollama）=====
LOCAL_MODEL=qwen2.5:1.5b
OLLAMA_HOST=http://127.0.0.1:11434

# ===== 云端推理（OpenAI 兼容协议）=====
# 默认指向 DeepSeek；通义/智谱/月之暗面 均可改 base_url 直接复用
CLOUD_MODEL=deepseek-chat
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_API_KEY=
# 可选备选：https://dashscope.aliyuncs.com/compatible-mode/v1  + qwen-plus
# 可选备选：https://open.bigmodel.cn/api/paas/v4        + glm-4-flash（免费）

# ===== 路由参数（消融实验的旋钮）=====
THETA_LOCAL=0.45
TAU_CONFIDENCE=0.55
ENABLE_ESCALATION=1
BUDGET_CNY=20.0

# ===== 生成参数 =====
MAX_TOKENS=512
TEMPERATURE=0.2
TIMEOUT_S=60

# --- deployment backend (see docs/deploy.md) ---
# ollama = local dev daemon | openai = llama-server (single container) | llamacpp = in-process
LOCAL_BACKEND=ollama
LOCAL_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_SERVED_MODEL=qwen2.5-1.5b

# rule = interpretable heuristic | learned = predict local correctness
ROUTER_MODE=rule
ROUTER_MODEL_PATH=data/router_model.json